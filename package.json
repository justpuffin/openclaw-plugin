  "description": "Puffin for OpenClaw: your agent's inbox, chats, contacts, calendar and tasks as tools, with approvals",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "homepage": "https://www.justpuffin.tech",
  "repository": {
